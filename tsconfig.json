{
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    "module": "node16",
    "target": "es2021",
    "jsx": "react-jsx",
    "outDir": "build/",
    "moduleResolution": "node16",
    "rootDir": "./src",
    "paths": {
      "*": ["./src/*"]
    },
    "types": ["vite/client"],
    "noErrorTruncation": true
  },
  "include": ["./src/**/*", "./test/**/*"],
  "exclude": ["./build/**/*"]
}
