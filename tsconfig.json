{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "target": "es2021",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "paths": {
      "*": ["./src/*"]
    },
    "types": ["vite/client"],
    "noErrorTruncation": true
  },
  "include": ["./src/**/*", "./test/**/*"],
  "exclude": ["./build/**/*"]
}
